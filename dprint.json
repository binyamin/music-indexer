{
	"lineWidth": 80,
	"useTabs": true,
	"typescript": {
		"quoteStyle": "preferSingle",
		"bracePosition": "sameLine"
	},
	"markdown": {
		"textWrap": "always"
	},
	"excludes": [
		"**/node_modules",
		"**/*-lock.json",
		"**/*-lock.yaml"
	],
	"plugins": [
		"https://plugins.dprint.dev/typescript-0.96.1.wasm",
		"https://plugins.dprint.dev/json-0.23.0.wasm",
		"https://plugins.dprint.dev/markdown-0.22.1.wasm"
	]
}
