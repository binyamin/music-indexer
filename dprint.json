{
	"lineWidth": 80,
	"useTabs": true,
	"typescript": {
		"quoteStyle": "preferSingle",
		"bracePosition": "sameLine"
	},
	"markdown": {
		"textWrap": "always"
	},
	"excludes": [
		"**/node_modules",
		"**/*-lock.json",
		"**/*-lock.yaml"
	],
	"plugins": [
		"npm:@dprint/typescript@0.96.1",
		"npm:@dprint/json@0.25.2",
		"npm:@dprint/markdown@0.28.0"
	]
}
